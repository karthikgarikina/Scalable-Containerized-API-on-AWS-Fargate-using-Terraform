# ==============================================================================
# Local Development Environment Variables
# NOTE: This file is used for local docker-compose and local development.
# AWS ECS Fargate runtime configuration is managed separately via Terraform
# environment block in the task definition (terraform/ecs.tf).
# ==============================================================================

# Application Settings
ENVIRONMENT=development
PORT=8000
APP_NAME=fargate-api

# Local Database Configuration (Used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
DB_HOST=db
DB_PORT=5432

# Complete Database Connection URL for local container environment
DATABASE_URL=postgresql://postgres:postgres@db:5432/app_db

# Database Connection Resiliency Settings
DB_CONNECT_RETRIES=10
DB_RETRY_DELAY=2.0
